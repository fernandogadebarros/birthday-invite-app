# Supabase (local: values printed by `pnpm db:start`; cloud: Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Public URL of the app (used in invite links, OG tags and magic-link redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/keep-alive
CRON_SECRET=change-me
